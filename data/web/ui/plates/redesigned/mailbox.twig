{% extends '@upstream/mailbox.twig' %}
{% block content %}
<section class="p-workspace" data-p-workspace data-p-role="{{ mailcow_cc_role }}">
  <header class="p-workspace-heading"><div><p class="p-kicker">{{ plates.text.workspace }}</p><h1 data-p-title>{{ lang.mailbox.domains }}</h1><p data-p-hint>{{ plates.text.domains_hint }}</p></div><button class="btn btn-primary p-button p-button-primary" type="button" data-p-create><i class="bi bi-plus-lg" aria-hidden="true"></i><span>{{ lang.mailbox.add_domain }}</span></button></header>
  <div class="p-workspace-counts"><button type="button" data-p-task="tab-domains"><i class="bi bi-globe2" aria-hidden="true"></i><span>{{ lang.mailbox.domains }}<strong>{{ domains|length }}</strong></span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></button><button type="button" data-p-task="tab-mailboxes"><i class="bi bi-inboxes" aria-hidden="true"></i><span>{{ lang.mailbox.mailboxes }}<strong>{{ mailboxes|length }}</strong></span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></button></div>
  <div class="p-list-panel">
    <div class="p-list-toolbar"><nav aria-label="{{ plates.text.navigation }}"><button type="button" data-p-task="tab-domains">{{ lang.mailbox.domains }}</button><button type="button" data-p-task="tab-mailboxes">{{ lang.mailbox.mailboxes }}</button><button type="button" data-p-task="tab-mbox-aliases">{{ lang.mailbox.aliases }}</button></nav><button class="p-icon-button" type="button" data-p-refresh aria-label="{{ plates.text.refresh }}"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></button></div>
    <div class="p-list-filters"><label class="p-search"><i class="bi bi-search" aria-hidden="true"></i><input type="search" data-p-search placeholder="{{ plates.text.search_placeholder }}" aria-label="{{ plates.text.search }}"></label><label data-p-domain-wrap hidden><span class="visually-hidden">{{ plates.text.domain_filter }}</span><select data-p-domain aria-label="{{ plates.text.domain_filter }}"><option value="">{{ plates.text.all_domains }}</option>{% for domain in domains %}<option value="{{ domain }}">{{ domain }}</option>{% endfor %}</select></label></div>
    <div data-p-results class="p-results" aria-live="polite" aria-busy="true"></div>
    <footer class="p-list-footer"><span data-p-result-count></span><div><button class="btn btn-secondary p-button" type="button" data-p-previous>{{ plates.text.previous }}</button><button class="btn btn-secondary p-button" type="button" data-p-next>{{ plates.text.next }}</button></div></footer>
  </div>
</section>
{% include 'components/create-dialogs.twig' %}
<details class="p-advanced" data-p-advanced><summary><span><strong>{{ plates.text.advanced }}</strong><small>{{ plates.text.advanced_hint }}</small></span><i class="bi bi-chevron-down" aria-hidden="true"></i></summary><div class="p-advanced-body">{{ parent() }}</div></details>
<script type="application/json" id="p-workspace-copy">{{ {
  'domains': lang.mailbox.domains, 'mailboxes': lang.mailbox.mailboxes, 'aliases': lang.mailbox.aliases,
  'domain_hint': plates.text.domains_hint, 'mailbox_hint': plates.text.mailboxes_hint, 'alias_hint': plates.text.aliases_hint,
  'add_domain': lang.mailbox.add_domain, 'add_mailbox': lang.mailbox.add_mailbox, 'add_alias': lang.mailbox.add_alias,
  'loading': plates.text.loading, 'load_error': plates.text.load_error, 'empty_title': plates.text.empty_title,
  'empty_hint': plates.text.empty_hint, 'no_results': plates.text.no_results, 'no_results_hint': plates.text.no_results_hint,
  'active': plates.text.active, 'inactive': plates.text.inactive, 'edit': plates.text.edit, 'storage': plates.text.storage,
  'open_mailboxes': plates.text.open_mailboxes, 'results': plates.text.results
}|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
{% endblock %}
